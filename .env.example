# Environment variables for Playwright API tests
# Copy this file to .env and fill in values for your environment.
# .env is gitignored and must never be committed.

# Base URL of the fis-common-standard-proxy API (config management)
# Default: http://localhost:5000 (local dev via `dotnet run`)
BASE_URL=http://localhost:5000

# Base URL of the proxy server
PROXY_BASE_URL=http://localhost:5001

# Base URL of the Transformer service (fis-common-transformer)
# Default: http://localhost:5002 (local dev)
TRANSFORMER_BASE_URL=http://localhost:5002

# API path segments — combined with BASE_URL to form endpoint URLs.
# Config management API route prefix (e.g. BASE_URL/CONFIG_API_BASE_PATH/providers)
CONFIG_API_BASE_PATH=proxy-configs/v1

# Auth0 JWT settings (used to obtain tokens in future auth helper extension)
AUTH_URL=
AUTH_AUDIENCE=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
